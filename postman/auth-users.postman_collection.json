            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario@biblioteca.cl\",\n  \"password\": \"Usuario2026!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Login con contraseña incorrecta -> 401",
          "event": [
