                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Mis pagos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Un pago de 2000\", function () { const p = pm.response.json(); pm.expect(p.length).to.eql(1); pm.expect(p[0].monto).to.eql(2000); });"
                ]
              }
