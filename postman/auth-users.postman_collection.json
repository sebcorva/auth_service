{
  "info": {
    "name": "auth-users",
    "description": "Microservicio de usuarios, login con JWT y pago premium (puerto 8081). Ejecutar las carpetas en orden (o Run collection). Los tokens e ids se guardan solos en variables de la colección.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Login",
      "item": [
        {
          "name": "Login ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set(\"tokenAdmin\", pm.response.json().token);"
