    {
      "name": "3. Pagos (usuario nuevo)",
      "item": [
        {
          "name": "Pagar premium",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Queda premium\", function () { pm.expect(pm.response.json().sesion.usuario.premium).to.eql(true); });",
                  "// El token anterior sigue diciendo premium=false: se reemplaza por el nuevo",
                  "pm.collectionVariables.set(\"tokenNuevo\", pm.response.json().sesion.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUsuarios}}/pagos/premium",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenNuevo}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
