# Copiar a .env y completar. .env y wallet/ estan en .gitignore: nunca se suben a git.
# La wallet de Oracle (descomprimida) va en la carpeta ./wallet del proyecto.
# <servicio> es el alias que aparece en wallet/tnsnames.ora (por ejemplo midb_high).
DB_URL=jdbc:oracle:thin:@<servicio>?TNS_ADMIN=./wallet
DB_USERNAME=USUARIOS_APP
DB_PASSWORD=<contrasena>

# Debe ser el MISMO valor configurado en gestor-biblioteca (minimo 32 caracteres para HS256)
JWT_SECRET=<secreto-jwt>

# Admin que se crea al arrancar si no existe ninguno
ADMIN_EMAIL=admin@biblioteca.cl
ADMIN_PASSWORD=<contrasena-admin>
